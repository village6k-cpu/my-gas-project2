# 별도 직원 앱에서 새로 발급한 값만 사용한다. 기존 Hermes/헤이빌리 토큰을 넣지 않는다.
LOCAL_CUA_SLACK_APP_TOKEN=xapp-replace-with-new-app-token
LOCAL_CUA_SLACK_BOT_TOKEN=xoxb-replace-with-new-bot-token

# 읽기 전용으로 확인한 현재 빌리지 대상. 앱 설치 후 app/bot ID를 채운다.
LOCAL_CUA_SLACK_TEAM_ID=T03EB8LSB18
LOCAL_CUA_SLACK_CHANNEL_ID=C0B7CLP4KDY
LOCAL_CUA_SLACK_APP_ID=A_REPLACE_AFTER_INSTALL
LOCAL_CUA_SLACK_BOT_USER_ID=U_REPLACE_AFTER_INSTALL
LOCAL_CUA_SLACK_ALLOWED_USER_ID=U03EB8L0QDR

# 반드시 이 프로세스만 소유하는 절대 경로를 사용하고 0700 권한을 유지한다.
LOCAL_CUA_LEDGER_DIR=/absolute/path/to/village-local-cua-clerk/ledger
