+    def _claim_capacity_available(self) -> bool:
+        from hermes_cli.active_sessions import resolve_max_concurrent_sessions
+        owner = getattr(getattr(self, "_message_handler", None), "__self__", None)
+        limit = resolve_max_concurrent_sessions(getattr(owner, "config", None))
+        if limit is None:
+            return True
+        occupied = len(self._leased_claims) + self._claim_reservations
+        running_count = getattr(owner, "_running_agent_count", None)
+        if callable(running_count):
+            occupied = max(occupied, running_count() + self._claim_reservations)
+        return occupied < limit
+
+    def _retain_claim_slot(self, fence: tuple[str, str, int, str], session_key: str) -> None:
+        """Keep capacity through a waiting handoff and its subsequent native turn."""
+        if fence not in self._leased_claims:
+            return
+        pending = self._pending_claim_handoffs.get(session_key)
+        task = None
+        if pending is not None:
+            correlation, pending_task = pending
+            pending_fence = (correlation.job_id, correlation.room_key,
+                             correlation.room_revision, correlation.lease_id)
+            if pending_fence == fence and not pending_task.done():
+                task = pending_task
+        if task is None and self._claim_fences.get(session_key) == fence:
+            active = self._session_tasks.get(session_key)
+            if active is not None and not active.done():
+                task = active
+        if task is None:
+            self._leased_claims.discard(fence)
+            return
+        task.add_done_callback(lambda _done: self._retain_claim_slot(fence, session_key))
