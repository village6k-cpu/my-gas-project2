         # _live_connections.  close() drains this set.
         self._read_conns: "set[sqlite3.Connection]" = set()
         self._read_conns_lock = threading.Lock()
+        self._read_conn_owners = {}
         # Set when close() begins.  _get_read_conn checks this under the
         # lock so a reader that finishes opening after the drain finds the
         # shutdown in progress and closes its own connection immediately.
@@ -2234,6 +2235,16 @@
 
     # ── Read-path split ──
 
+    def _prune_retired_readers(self) -> None:
+        """Release only readers whose owning thread has already terminated."""
+        with self._read_conns_lock:
+            for conn, owner in list(self._read_conn_owners.items()):
+                if owner.is_alive():
+                    continue
+                conn.close()
+                self._read_conns.discard(conn)
+                self._read_conn_owners.pop(conn, None)
+
     def _get_read_conn(self) -> Optional[sqlite3.Connection]:
         """Per-thread read-only connection, or None when unavailable.
 
