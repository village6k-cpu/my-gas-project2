PORT=8787
DEBOUNCE_MS=90000
MAX_WAIT_MS=300000
STARTUP_MUTATION_IGNORE_MS=4000
QUEUE_DIR=./queue

# Persistent runtime selector. Missing is legacy-safe; any value other than
# legacy or v2 is rejected. Persist v2 only during the authorized cutover.
WORK_ORCHESTRATOR_V2_RUNTIME_MODE=legacy
WORK_ORCHESTRATOR_V2_SHADOW_WRITES=0
WORK_ORCHESTRATOR_V2_IMMEDIATE_ENABLED=0
WORK_ORCHESTRATOR_V2_WORK_ITEMS_ENABLED=0
WORK_ORCHESTRATOR_V2_DIGEST_ENABLED=0
WORK_ORCHESTRATOR_V2_CLEANUP_ENABLED=0
WORK_ORCHESTRATOR_V2_INBOX_CHANNEL_ID=
WORK_ORCHESTRATOR_V2_DIGEST_CHANNEL_ID=
WORK_ORCHESTRATOR_V2_DIGEST_INTERVAL_MINUTES=180
WORK_ORCHESTRATOR_V2_AUTO_NOTICE_TTL_MINUTES=180
# Notice cleanup stays locally unready until these exact auth.test identities
# are pinned. Do not guess them and do not use message search for deletion.
WORK_ORCHESTRATOR_V2_SLACK_BOT_USER_ID=
WORK_ORCHESTRATOR_V2_SLACK_BOT_ID=
WORK_ORCHESTRATOR_V2_SLACK_TEAM_ID=
WORK_ORCHESTRATOR_V2_CLEANUP_OWNER=bridge:notice-cleanup
WORK_ORCHESTRATOR_V2_CLEANUP_LEASE_SECONDS=120
WORK_ORCHESTRATOR_V2_CLEANUP_INTERVAL_MS=300000
# Offline-reviewed reversible cutover target (Task 7 authorization and runtime
# readback are still required; this example does not prove a live cutover):
# WORK_ORCHESTRATOR_V2_RUNTIME_MODE=v2
# WORK_ORCHESTRATOR_V2_SHADOW_WRITES=1
# WORK_ORCHESTRATOR_V2_IMMEDIATE_ENABLED=1
# WORK_ORCHESTRATOR_V2_WORK_ITEMS_ENABLED=1
# WORK_ORCHESTRATOR_V2_DIGEST_ENABLED=1
# WORK_ORCHESTRATOR_V2_CLEANUP_ENABLED=1
# WORK_ORCHESTRATOR_V2_P0_READBACK_ENABLED=1
# WORK_ORCHESTRATOR_V2_P0_CUTOVER_ENABLED=1
# AI_WORKER_FOLLOW_UP_ITEMS_ENABLED=0
# KAKAO_FOLLOW_UP_ITEMS_ENABLED=0
# SLACK_AGENT_CARD_DELIVERY_ENABLED=0
# P0_SLACK_ESCALATION_ENABLED=0
# SLACK_ACTION_POLL_ENABLED=0
# Rollback is one exact contract: persist WORK_ORCHESTRATOR_V2_RUNTIME_MODE=legacy,
# restore all legacy card/work/P0/action flags to 1, set every v2 flag above to 0,
# then use the bounded restart path and verify selected-mode health readback.

# Native Hermes Gateway transport is opt-in. Keep cli until the offline bridge
# channel and adapter have both been verified; leave the bridge token blank here.
KAKAO_HERMES_TRANSPORT=cli
KAKAO_HERMES_BRIDGE_TOKEN=
KAKAO_HERMES_LEASE_MS=300000
KAKAO_HERMES_MAX_ATTEMPTS=2

# Optional: Supabase 처리판에 pending_ai_review / ready_for_ai_worker 이벤트를 저장할 때만 설정
# 먼저 Supabase SQL Editor에서 tools/kakao-dom-bridge/supabase-schema.sql 을 실행하세요.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_TABLE=ai_processing_events
SUPABASE_FOLLOW_UP_TABLE=ai_follow_up_items
# Safe pre-cutover compatibility defaults: keep legacy durable work output on
# while the v2 flags above remain off. The reviewed target turns both paths over
# together only after separately authorized runtime readback.
AI_WORKER_FOLLOW_UP_ITEMS_ENABLED=1
KAKAO_FOLLOW_UP_ITEMS_ENABLED=1

# Optional: debounce 완료 후 AI 브라우저 직원 실행 명령
# Payload is passed as stdin JSON.
# Leave commented until the real AI worker command exists.
# If enabled, quote the value because it contains spaces.
# VILLAGE_AI_WORKER_CMD="node ../your-ai-browser-worker/index.mjs"

# Optional: live Hermes worker safety timeout. Keep short enough that one Kakao message cannot hang for 10+ minutes.
HERMES_WORKER_TIMEOUT_MS=180000

# Optional: durable recovery. The bridge periodically replays ready/error jobs that survived a restart or timeout.
SUPABASE_RECOVERY_ENABLED=true
SUPABASE_RECOVERY_INTERVAL_MS=300000
SUPABASE_RECOVERY_BATCH_SIZE=2
SUPABASE_RECOVERY_LOOKBACK_HOURS=36
SUPABASE_RECOVERY_ERROR_RETRY_MS=900000
SUPABASE_RECOVERY_MAX_ATTEMPTS=2

# Optional legacy flag: follow-up rows are reports/dashboard records by default.
SLACK_FOLLOW_UP_ENABLED=false
# Safe pre-cutover default: preserve legacy cards while v2 immediate delivery is off.
SLACK_AGENT_CARD_DELIVERY_ENABLED=1
# Legacy P0 escalation remains enabled unless the authorized v2 P0 cutover target
# above is applied with both v2 P0 readback and cutover flags set to 1.
P0_SLACK_ESCALATION_ENABLED=1
# Requires Slack bot token scopes when agent-card delivery is deliberately enabled:
# chat:write, channels:read, groups:read.
SLACK_BOT_TOKEN=
# Server-owned Slack user IDs for cards and Work Orchestrator immediate notices.
# Leave blank or use comma/space-separated U/W IDs; invalid values are ignored.
SLACK_CARD_MENTION_USER_IDS=
SLACK_CHANNEL_SCHEDULE_AGENT=스케쥴-agent
SLACK_CHANNEL_DOCUMENT_AGENT=서류발송-agent
SLACK_CHANNEL_SETTLEMENT_AGENT=정산-agent
SLACK_CHANNEL_OTHER_AGENT=기타문의

# Legacy Slack action-row polling. Exact v2 mode freezes this path at 0; the
# separate Work Orchestrator v2 action poller remains active.
SLACK_ACTION_POLL_ENABLED=true
# 0 = all unresolved Slack task candidates, not only old/stale ones.
SLACK_BACKSTOP_MIN_AGE_HOURS=0
SLACK_BACKSTOP_LOOKBACK_HOURS=720
SLACK_BACKSTOP_MAX_MESSAGES=500
SLACK_ACTION_POLL_INTERVAL_MS=10000

# Optional: close stale individual Kakao conversation tabs when the worker is idle.
KAKAO_TAB_CLEANUP_ENABLED=true
KAKAO_TAB_CLEANUP_INTERVAL_MS=120000

# Optional: keep automation quality first while avoiding the worst human conflicts.
# Normal 🤖 자동화 크롬 uses the real Chrome profile store, where Chrome 149 may refuse
# DevTools even when --remote-debugging-port is present. Enable AppleScript/CUA fallback.
# devtools_first tries DevTools first, then CUA; cua_first skips the DevTools timeout path.
# devtools_only disables CUA and is not recommended for normal-profile operation.
KAKAO_APPLESCRIPT_FALLBACK=1
KAKAO_WORKER_CONTROL_MODE=devtools_first
KAKAO_CUA_MIN_IDLE_SECONDS=0

# Optional: village-ai read-only RAG reference search for the AI worker.
# Do NOT give Hermes Supabase/RPC/Cohere keys. Use village-ai /api/ask as a reference-answer tool only.
# RAG must be used only after Kakao conversation is opened, and only as reference memory.
# It must not replace Kakao screen evidence or Sheets/GAS duplicate checks.
# VILLAGE_AI_URL=http://localhost:3000
# VILLAGE_AI_KAKAO_SKILL_SECRET=replace-me
# VILLAGE_AI_RAG_TIMEOUT_MS=30000
